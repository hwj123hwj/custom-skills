---
import AppLayout from '../../layouts/AppLayout.astro';
import { SkillDetailView } from '../../components/SkillDetailView';
import type { Skill } from '../../types/skill';
import skillsData from '../../data/skills-data.json';
import { pickDescription } from '../../lib/i18n-utils';

// 为每个技能生成静态页面
export async function getStaticPaths() {
  const skills = skillsData as Skill[];
  return skills.map((skill) => ({
    params: { id: skill.id },
    props: { skill },
  }));
}

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;

const shortDesc = pickDescription(skill.id, skill.description, 'zh');
const detailedDesc = pickDescription(skill.id, skill.detailedDescription || skill.description, 'zh');
const seoTitle = `${skill.displayName} - AI Agent 技能 | Custom Skills Hub`;
const seoDesc = shortDesc || `安装 ${skill.displayName} 技能到你的 AI Agent`;

// JSON-LD 结构化数据
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: skill.displayName,
  description: seoDesc,
  url: `https://hwj123hwj.asia/skill/${skill.id}`,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  installUrl: skill.installCommand,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hwj123hwj.asia/' },
    { '@type': 'ListItem', position: 2, name: 'Skills', item: 'https://hwj123hwj.asia/' },
    { '@type': 'ListItem', position: 3, name: skill.displayName, item: `https://hwj123hwj.asia/skill/${skill.id}` },
  ],
};
---

<AppLayout title={seoTitle} description={seoDesc} canonical={`https://hwj123hwj.asia/skill/${skill.id}`}>
  <Fragment slot="head">
    <title>{seoTitle}</title>
    <meta name="description" content={seoDesc} />
    <link rel="canonical" href={`https://hwj123hwj.asia/skill/${skill.id}`} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDesc} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={`https://hwj123hwj.asia/skill/${skill.id}`} />
    <meta property="og:site_name" content="Custom Skills Hub" />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" hreflang="zh" href={`https://hwj123hwj.asia/skill/${skill.id}`} />
    <link rel="alternate" hreflang="en" href={`https://hwj123hwj.asia/skill/${skill.id}?lng=en`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <SkillDetailView id={skill.id} client:load />
</AppLayout>
