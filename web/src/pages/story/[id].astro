---
import AppLayout from '../../layouts/AppLayout.astro';
import { StoryDetailView } from '../../components/StoryDetailView';
import storiesData from '../../data/stories-data.json';
import type { Story } from '../../types/story';

export async function getStaticPaths() {
  const stories = storiesData as Story[];
  return stories.map((story) => ({
    params: { id: story.id },
    props: { story },
  }));
}

interface Props {
  story: Story;
}

const { story } = Astro.props as Props;
const title = `${story.title} | Custom Skills Hub`;
const description = story.summary || `${story.title} - AI agent development story`;
const canonical = `https://hwj123hwj.asia/story/${story.id}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: story.title,
  description: description,
  url: canonical,
  dateModified: story.lastUpdated,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hwj123hwj.asia/' },
    { '@type': 'ListItem', position: 2, name: 'Stories', item: 'https://hwj123hwj.asia/' },
    { '@type': 'ListItem', position: 3, name: story.title, item: canonical },
  ],
};
---

<AppLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>
  <StoryDetailView client:load id={story.id} />
</AppLayout>
