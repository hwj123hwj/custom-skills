---
import AppLayout from '../../layouts/AppLayout.astro';
import { AgentDetailView } from '../../components/AgentDetailView';
import agentsData from '../../data/agents-data.json';
import type { Agent } from '../../types/agent';

function toTitleCase(str: string): string {
  return str.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}

export async function getStaticPaths() {
  const agents = agentsData as Agent[];
  return agents.map((agent) => ({
    params: { id: agent.id },
    props: { agent },
  }));
}

interface Props {
  agent: Agent;
}

const { agent } = Astro.props as Props;
const agentName = toTitleCase(agent.name);
const agentDesc = agent.description || `${agentName} AI agent for automation`;
const title = `${agentName} Agent | Custom Skills Hub`;
const description = agentDesc;
const canonical = `https://hwj123hwj.asia/agent/${agent.id}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `${agentName} Agent`,
  description: agentDesc,
  url: canonical,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hwj123hwj.asia/' },
    { '@type': 'ListItem', position: 2, name: 'Agents', item: 'https://hwj123hwj.asia/' },
    { '@type': 'ListItem', position: 3, name: agentName, item: canonical },
  ],
};
---

<AppLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>
  <AgentDetailView client:load id={agent.id} />
</AppLayout>
