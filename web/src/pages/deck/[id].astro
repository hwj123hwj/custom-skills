---
import AppLayout from '../../layouts/AppLayout.astro';
import { DeckDetailView } from '../../components/DeckDetailView';
import decksData from '../../data/decks-data.json';
import type { Deck } from '../../types/deck';

export async function getStaticPaths() {
  const decks = decksData as Deck[];
  return decks.map((deck) => ({
    params: { id: deck.id },
    props: { deck },
  }));
}

interface Props {
  deck: Deck;
}

const { deck } = Astro.props as Props;
const title = `${deck.title} | Custom Skills Hub`;
const description = deck.summary || `${deck.title} - Interactive HTML deck presentation`;
const canonical = `https://hwj123hwj.asia/deck/${deck.id}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: deck.title,
  description: description,
  url: canonical,
  dateModified: deck.lastUpdated,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hwj123hwj.asia/' },
    { '@type': 'ListItem', position: 2, name: 'Decks', item: 'https://hwj123hwj.asia/' },
    { '@type': 'ListItem', position: 3, name: deck.title, item: canonical },
  ],
};
---

<AppLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>
  <DeckDetailView client:load id={deck.id} />
</AppLayout>
